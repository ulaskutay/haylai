# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
# Auth: true = skip login (guest user). Set AUTH_DISABLED=false when you enable Google/magic link.
AUTH_DISABLED=true
NEXT_PUBLIC_AUTH_DISABLED=true
CREDITS_DISABLED=true
NEXT_PUBLIC_CREDITS_DISABLED=true
WORKER_CALLBACK_SECRET=change-me-to-a-long-random-string

# Storage: local now, hetzner later (S3-compatible)
STORAGE_DRIVER=local
# Leave empty to use <repo>/data/audio
# STORAGE_ROOT=/absolute/path/to/data/audio
STORAGE_SIGNING_SECRET=change-me-to-a-long-random-string
# HETZNER_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# HETZNER_S3_REGION=fsn1
# HETZNER_S3_BUCKET=hayl-audio
# HETZNER_S3_ACCESS_KEY=
# HETZNER_S3_SECRET_KEY=

# Processing: runpod (önerilen) | auto | local | mock
PROCESS_MODE=runpod
WORKER_URL=http://localhost:8000

# RunPod Serverless — min workers 0. Public APP_URL gerekir (webhook + signed media).
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Worker (lokal CPU veya RunPod image)
PIPELINE_MODE=cpu
DEMUCS_MODEL=htdemucs
RVC_MODEL_PATH=
RVC_INFER_PY=
RVC_INDEX_PATH=

# Beat AI (RunPod GPU — ACE-Step > Stable Audio > MusicGen fallback)
BED_ML_ENABLED=true
BED_ENGINE=auto
BED_MAX_SECONDS=60
ACESTEP_MODEL=ACE-Step/acestep-v15-xl-turbo-diffusers
ACESTEP_STEPS=8
STABLE_AUDIO_MODEL=stabilityai/stable-audio-open-1.0
STABLE_AUDIO_STEPS=100
MUSICGEN_MODEL=facebook/musicgen-medium
MUSICGEN_GUIDANCE=4.5
BED_MODE=auto

CALLBACK_SECRET=change-me-to-a-long-random-string
